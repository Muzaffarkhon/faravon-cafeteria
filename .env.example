# PostgreSQL. Приложение ходит через ПУЛ (Neon: хост с суффиксом `-pooler`) и
# обязательно с pgbouncer=true — без этого флага Prisma под конкуренцией
# падает с `prepared statement "s0" already exists`.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Прямое подключение (хост БЕЗ `-pooler`) — только для prisma migrate/introspect.
DIRECT_URL="postgresql://neondb_owner:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing key — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-string"

SHADOW_DATABASE_URL="postgresql://faravon:faravon@localhost:5433/faravon_shadow?schema=public"

# Telegram-бот авторизации (§5.1). Токен от @BotFather. Без токена бот не запускается,
# а вход по логину/паролю продолжает работать.
TELEGRAM_BOT_TOKEN=""
PLATFORM_URL="http://localhost:3001"

# Секрет для webhook-режима (Vercel): передаётся в setWebhook и проверяется
# роутом /api/telegram по заголовку X-Telegram-Bot-Api-Secret-Token.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=""

# Секрет для Vercel Cron (§5.10): защищает /api/cron/deliver-notifications.
# Vercel автоматически шлёт заголовок Authorization: Bearer $CRON_SECRET.
# Локально бот доставляет уведомления сам (npm run bot) — переменная не нужна.
CRON_SECRET=""

# Vercel Blob — хранилище изображений карточек льгот. На Vercel создаётся автоматически
# при добавлении Blob-store (Storage → Create → Blob). Локально: `vercel env pull`.
# Без токена загрузка файла не работает; вставка ссылки вручную — работает.
BLOB_READ_WRITE_TOKEN=""

# Тестовая среда (песочница), см. docs/SANDBOX.md.
# SANDBOX_LABEL задаётся ТОЛЬКО на тестовом деплое: включает жёлтую плашку наверху
# и разблокирует очистку тестовых данных в разделе «Тестовая среда».
SANDBOX_LABEL=""
# SANDBOX_URL задаётся ТОЛЬКО на боевом: адрес песочницы для ссылки из админки.
SANDBOX_URL=""
