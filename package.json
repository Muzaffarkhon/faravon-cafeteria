{
  "name": "faravon-cafeteria",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/predeploy.mjs && prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --force",
    "bot": "tsx bot/bot.ts",
    "webhook": "tsx scripts/set-webhook.ts",
    "bot:commands": "tsx scripts/set-commands.ts",
    "flow:status": "tsx scripts/flow-status.ts",
    "flow:reset": "tsx scripts/flow-reset.ts",
    "flow:e2e": "tsx scripts/flow-e2e.ts",
    "demo:reset": "tsx scripts/reset-demo-users.ts",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "deepmerge-ts": "^8.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.8.0",
    "bcryptjs": "^3.0.3",
    "exceljs": "^4.4.0",
    "jose": "^6.2.10",
    "jsqr": "^1.4.0",
    "next": "16.3.3",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
