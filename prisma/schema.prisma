// Кафетерий льгот «Фаровон» — схема данных (ТЗ v2)
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider          = "postgresql"
  // Приложение ходит через пул Neon (хост с суффиксом `-pooler`, обязательно
  // с `?pgbouncer=true`) — иначе под нагрузкой Prisma падает с
  // `prepared statement "s0" already exists`.
  url               = env("DATABASE_URL")
  // Миграции и introspection — только по прямому подключению (хост без `-pooler`).
  directUrl         = env("DIRECT_URL")
  // Shadow DB is created from template0 to avoid the postgis image's template1 collation quirk
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

/// Роли доступа (RBAC)
enum Role {
  C_AND_B
  EMPLOYEE
  CONTRACTOR
}

enum Block {
  RECOGNITION // Программы признания (5.4)
  CARE        // Витрина заботы (5.5)
  FLEX        // Реестр гибких льгот (5.6)
}

enum CardStatus {
  DRAFT
  PUBLISHED
}

enum PartnerStatus {
  ACTIVE
  SOON
  ARCHIVED
}

enum PeriodStatus {
  DRAFT
  OPEN
  CLOSED
}

/// Статусы позиции заявки, раздел 5.7
enum ItemStatus {
  DRAFT
  PENDING          // На рассмотрении
  APPROVED         // Одобрено согласующим
  COUPON_CREATED   // Купон сформирован
  COUPON_ISSUED    // Купон выдан
  REJECTED         // Отклонено
  CANCELLED        // Отменено сотрудником
}

enum CouponStatus {
  CREATED
  ISSUED
  USED
  EXPIRED
  CANCELLED
}

enum EmploymentStatus {
  ACTIVE
  PROBATION
  TERMINATED
}

/// Способ выдачи льготы партнёром.
/// QR         — стандартный поток: купон с номером/QR, гашение на «Кассе партнёра».
/// PHONE_PROMO — у подрядчика своя система (напр. сервис такси): наш QR не нужен,
///               работа идёт по номеру телефона сотрудника + рассылка промокодов.
enum DeliveryMode {
  QR
  PHONE_PROMO
}

/// Тип баннера на витрине сотрудника.
/// PARTNER — реклама партнёра.
/// NEWS    — своя новость / анонс компании без пометки «Партнёр».
enum BannerKind {
  PARTNER
  NEWS
}

/// Статус обращения обратной связи (обрабатывает C&B).
enum FeedbackStatus {
  NEW    // новое
  READ   // прочитано
  NOTED  // принято к сведению
  CLOSED // закрыто
}

enum SupportThreadStatus {
  OPEN
  CLOSED
}

enum SupportMessageDirection {
  IN  // от гостя
  OUT // от C&B
}

model Employee {
  id           String           @id @default(cuid())
  seq          Int              @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  fullName     String
  position     String
  department   String
  phone           String?
  phoneNormalized String?        // последние 9 цифр номера — для быстрого поиска при входе через Telegram
  phoneSecondary  String?
  phoneSecondaryNormalized String?
  telegramId   String?          @unique
  status       EmploymentStatus @default(ACTIVE)
  terminatedAt DateTime?
  isActive     Boolean          @default(true)
  archivedAt   DateTime?        // сотрудник в архиве — скрыт из основного списка, но история сохранена
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user         User?
  applications Application[]
  coupons      Coupon[]
  feedback     Feedback[]

  @@index([archivedAt])
  @@index([fullName])
  @@index([isActive])
  @@index([phoneNormalized])
  @@index([phoneSecondaryNormalized])
}

model User {
  id                String    @id @default(cuid())
  seq               Int       @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  login             String    @unique
  passwordHash      String
  mustChangePassword Boolean  @default(true)
  twoFactorEnabled  Boolean   @default(false)
  isActive          Boolean   @default(true)
  telegramId        String?   @unique // §11/§12: Telegram-адресат для учёток без Employee (подрядчики, C&B)
  roles             Role[]    @default([EMPLOYEE])
  lastLoginAt       DateTime?
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  otpExpiresAt      DateTime? // срок действия одноразового пароля, выданного через Telegram-бот (§5.1)
  sessionEpoch      Int       @default(0) // §5.1: bump — принудительный выход со всех устройств
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  employee   Employee? @relation(fields: [employeeId], references: [id])
  employeeId String?   @unique

  // Подрядчик привязан к партнёру: гасит только его купоны. null у CONTRACTOR = гасит любые.
  // Restrict: партнёра с привязанными подрядчиками нельзя удалить (иначе scoped-
  // подрядчик тихо становился бы «глобальным» после SetNull).
  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  partnerId String?

  auditLogs       AuditLog[]
  notifications   Notification[]
  decisions       ApplicationItem[]      @relation("DecidedBy")
  cardEdits       BenefitCardVersion[]   @relation("CardVersionEditor")
  templateEdits   NotificationTemplate[] @relation("NotificationTemplateEditor")
  feedbackHandled Feedback[]             @relation("FeedbackHandler")
  supportReplies  SupportMessage[]

  @@index([partnerId])
}

/// Попытки входа — для ограничения перебора по IP и журнала последних входов (§5.1)
model LoginAttempt {
  id        String   @id @default(cuid())
  login     String
  ip        String
  userAgent String?
  success   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([login, createdAt])
}

/// Попытки идентификации в Telegram-боте (§5.1) — для rate-limit и защиты от
/// перебора номеров/кодов и от массовой генерации OTP. Пишется на каждую
/// попытку /code, /login и «поделиться контактом».
model TelegramAuthAttempt {
  id         String   @id @default(cuid())
  telegramId String
  kind       String // "phone" | "code" | "reissue"
  ok         Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([telegramId, createdAt])
}

/// Одноразовый код идентификации сотрудника в Telegram-боте (§5.1, способ «код от HR»)
model IdentificationCode {
  id         String    @id @default(cuid())
  code       String    @unique
  employeeId String
  issuedById String?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([employeeId])
}

model Partner {
  id            String        @id @default(cuid())
  seq           Int           @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  name          String
  category      String?
  contactPerson String?
  contacts      String?
  discountType  String?
  terms         String?
  contractStart DateTime?
  contractEnd   DateTime?
  responsible   String?
  status        PartnerStatus @default(ACTIVE)
  deliveryMode  DeliveryMode  @default(QR) // PHONE_PROMO — подрядчик со своей системой (такси): без QR, по номеру телефона
  logoUrl       String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  cards               BenefitCard[]
  coupons             Coupon[]
  banners             PartnerBanner[]
  serviceUsers        User[]
  advertisingRequests AdvertisingRequest[]
}

model BenefitCard {
  id          String     @id @default(cuid())
  block       Block
  title       String
  description String?
  condition   String?
  imageUrl    String?
  category    String?
  isActive    Boolean    @default(true) // false => метка «скоро»
  status      CardStatus @default(PUBLISHED)
  sortOrder   Int        @default(0)
  minParticipants Int    @default(1) // групповая скидка: сколько сотрудников должно выбрать льготу, чтобы она заработала. 1 = без порога.
  archivedAt  DateTime?  // карточка в архиве — не показывается сотрудникам и в основном списке
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  partner   Partner? @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  partnerId String?

  items    ApplicationItem[]
  versions BenefitCardVersion[]

  @@index([archivedAt])
}

/// Снимок состояния карточки льготы на момент изменения (история версий).
/// Последняя версия всегда равна текущей карточке; «восстановление» — это
/// новое изменение карточки полями выбранной версии (обратимо).
model BenefitCardVersion {
  id      String @id @default(cuid())
  card    BenefitCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  cardId  String
  version Int

  // Снимок полей карточки
  block       Block
  title       String
  description String?
  condition   String?
  imageUrl    String?
  category    String?
  isActive    Boolean
  status      CardStatus
  sortOrder   Int
  minParticipants Int   @default(1)
  partnerId   String?

  editedBy   User?   @relation("CardVersionEditor", fields: [editedById], references: [id])
  editedById String?
  reason     String? // "created" | "updated" | "restored:vN"
  createdAt  DateTime @default(now())

  @@unique([cardId, version])
  @@index([cardId])
}

model Period {
  id             String       @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  windowStart    DateTime
  windowEnd      DateTime
  status         PeriodStatus @default(DRAFT)
  maxSelections  Int          @default(4)
  windowOpenNotifiedAt   DateTime? // §5.10: разослано «окно выбора открыто»
  windowClosingNotifiedAt DateTime? // §5.10: разослано напоминание «закроется через 3 дня»
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  applications Application[]
  coupons      Coupon[]
}

model Application {
  id         String   @id @default(cuid())
  employee   Employee @relation(fields: [employeeId], references: [id])
  employeeId String
  period     Period   @relation(fields: [periodId], references: [id])
  periodId   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items ApplicationItem[]

  @@unique([employeeId, periodId])
  @@index([periodId])
}

model ApplicationItem {
  id            String     @id @default(cuid())
  seq           Int        @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId String
  card          BenefitCard @relation(fields: [cardId], references: [id])
  cardId        String
  status        ItemStatus  @default(DRAFT)
  decisionComment String?
  contactPhone  String?     // §такси: номер, который сотрудник указал при выборе PHONE_PROMO-льготы (промокод уйдёт на него)
  decidedBy     User?       @relation("DecidedBy", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  submittedAt   DateTime?
  escalationLevel Int       @default(0) // последний сработавший уровень SLA-эскалации (§5.12)
  lastEscalatedAt DateTime?
  // Групповая льгота не набрала порог к концу периода — позиция переносится в
  // следующий период новой позицией; carriedFromId указывает на исходную.
  carriedFrom   ApplicationItem?  @relation("ItemCarry", fields: [carriedFromId], references: [id], onDelete: SetNull)
  carriedFromId String?           @unique
  carriedTo     ApplicationItem?  @relation("ItemCarry")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  coupon Coupon?

  @@unique([applicationId, cardId]) // одна льгота — один раз за период
  @@index([applicationId])
  @@index([status])
  @@index([cardId])
}

/// Матрица SLA-эскалаций по «зависшим» на согласовании позициям (§5.12).
/// Крон-задача раз в N минут проверяет PENDING-позиции: если прошло больше
/// `afterHours` от `submittedAt`, а `escalationLevel` позиции меньше `level`,
/// шлёт уведомление `SLA_ESCALATION` пользователям ролей `notifyRoles`.
model SlaEscalationRule {
  id          String   @id @default(cuid())
  level       Int      @unique
  afterHours  Int
  notifyRoles Role[]
  active      Boolean  @default(true)
  updatedAt   DateTime @updatedAt
}

model Coupon {
  id              String       @id @default(cuid())
  seq             Int          @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  number          String       @unique
  item            ApplicationItem @relation(fields: [itemId], references: [id])
  itemId          String       @unique
  partner         Partner?     @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  partnerId       String?
  employee        Employee     @relation(fields: [employeeId], references: [id])
  employeeId      String
  period          Period       @relation(fields: [periodId], references: [id])
  periodId        String
  type            String       @default("PROMO") // PROMO | QR | PDF | PHYSICAL
  nominal         String?
  status          CouponStatus @default(CREATED)
  deliveryChannel String       @default("PORTAL")
  issuedAt        DateTime?
  validUntil      DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([periodId])
  @@index([status])
  @@index([employeeId])
  @@index([partnerId])
}

model PartnerBanner {
  id         String     @id @default(cuid())
  partner    Partner?   @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerId  String?
  kind       BannerKind @default(PARTNER) // NEWS — своя новость/анонс без пометки «Партнёр»
  title      String
  subtitle   String?
  imageUrl   String?
  href       String?
  androidUrl String?    // ссылка на приложение для Android (Google Play или прямой .apk)
  iosUrl     String?    // ссылка на приложение в App Store
  isActive   Boolean    @default(true)
  sortOrder  Int        @default(0)
  startsAt   DateTime?
  endsAt     DateTime?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model AdvertisingRequest {
  id              String    @id @default(cuid())
  seq             Int       @unique @default(autoincrement()) // сквозной номер по порядку создания — для короткого отображения (RowId)
  // Заявку подаёт партнёр (учётка подрядчика, привязанная к партнёру).
  partner         Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  partnerId       String?
  companyName     String
  contactName     String
  contactPhone    String
  productName     String
  productDescription String
  androidUrl      String?   // ссылка на приложение для Android (Google Play или прямой .apk)
  iosUrl          String?   // ссылка на приложение в App Store
  status          String    @default("PENDING")
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([partnerId])
}

/// Обращение обратной связи от сотрудника. Обрабатывает C&B:
/// NEW → READ (прочитано) → NOTED (принято к сведению) → CLOSED (закрыто).
model Feedback {
  id          String         @id @default(cuid())
  employee    Employee       @relation(fields: [employeeId], references: [id])
  employeeId  String
  topic       String?        // необязательная тема
  message     String
  status      FeedbackStatus @default(NEW)
  adminNote   String?        // комментарий C&B при обработке
  handledBy   User?          @relation("FeedbackHandler", fields: [handledById], references: [id])
  handledById String?
  handledAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([employeeId])
  @@index([createdAt])
}

/// Один Telegram-чат — один тред, переоткрывается при новом сообщении
/// гостя, а не плодится заново. Заводится, когда бот не смог опознать
/// человека и тот нажал «Написать администратору».
model SupportThread {
  id            String              @id @default(cuid())
  seq           Int                 @unique @default(autoincrement()) // сквозной номер — для короткого отображения (RowId), тот же приём, что и у остальных сущностей
  telegramId    String              @unique
  /// Номер, который человек присылал (если делился контактом) — подсказка
  /// C&B, кто это, даже если официально не опознан.
  phone         String?
  status        SupportThreadStatus @default(OPEN)
  /// НЕ @updatedAt — обновляем явно при каждом сообщении (в обе стороны),
  /// а не при любом изменении строки (например, при правке phone).
  lastMessageAt DateTime            @default(now())
  createdAt     DateTime            @default(now())

  messages SupportMessage[]

  @@index([status, lastMessageAt])
}

model SupportMessage {
  id        String                  @id @default(cuid())
  thread    SupportThread           @relation(fields: [threadId], references: [id])
  threadId  String
  direction SupportMessageDirection
  body      String
  /// Кто из C&B ответил — только для OUT.
  author    User?                   @relation(fields: [authorId], references: [id])
  authorId  String?
  /// Прочитано C&B — только для IN, для счётчика непрочитанных.
  readAt    DateTime?
  createdAt DateTime                @default(now())

  @@index([threadId, createdAt])
}

/// Заготовленные быстрые ответы C&B в чате поддержки — админ сам ведёт список,
/// клик подставляет текст в поле ответа вместо набора с нуля.
model SupportQuickReply {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Частые вопросы для гостя в Telegram-чате поддержки: `question` — подпись
/// инлайн-кнопки (лимит Telegram ~64 символа), `answer` — шаблонный текст,
/// который бот отправляет автоматически по нажатию. Кнопки прикрепляются к
/// каждому сообщению бота в этом чате (см. getFaqKeyboard в support-chat.ts).
model SupportFaq {
  id        String   @id @default(cuid())
  seq       Int      @unique @default(autoincrement())
  question  String
  answer    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TextBlock {
  key       String   @id // GOAL | NOVELTY_NOTICE
  title     String
  content   String
  updatedAt DateTime @updatedAt
}

/// Редактируемые шаблоны текстов уведомлений (§5.10). `event` совпадает с
/// Notification.event. В `body` — плейсхолдеры вида {employee}, {card}; блок
/// [[ ... {x} ... ]] выкидывается целиком, если {x} пустой. Если строки нет —
/// приложение берёт зашитый шаблон по умолчанию (DEFAULT_TEMPLATES).
model NotificationTemplate {
  event       String   @id
  label       String
  body        String
  updatedBy   User?    @relation("NotificationTemplateEditor", fields: [updatedById], references: [id])
  updatedById String?
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String
  event       String
  channel     String    @default("TELEGRAM")
  payload     Json?
  sentAt      DateTime  @default(now())
  readAt      DateTime?
  deliveredAt DateTime? // выставляется Telegram-ботом после отправки сообщения (§5.10)

  @@index([userId])
  @@index([deliveredAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      User?    @relation(fields: [actorId], references: [id])
  actorId    String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
}

/// Матрица прав, редактируемая на /admin/access. Ключи permission — из src/lib/rbac.ts.
/// Отсутствие строки для (role, permission) трактуется как значение по умолчанию из кода.
model RolePermission {
  role       Role
  permission String
  allowed    Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@id([role, permission])
}
