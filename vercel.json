{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["bom1"],
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && [ \"$VERCEL_GIT_COMMIT_REF\" != \"main\" ]",
  "crons": [
    { "path": "/api/cron/deliver-notifications", "schedule": "30 3 * * *" },
    { "path": "/api/cron/daily-digest", "schedule": "0 4 * * *" }
  ]
}
